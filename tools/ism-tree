#!/usr/bin/env sh

version="1.2"

usage() {
  cat << EOF2
ISM Tree — генератор структуры каталогов.
Версия: $version

Использование: $(basename "$0") [ОПЦИИ] [директория]

Опции:
  --all                Показывать скрытые файлы и директории
  --plain              Плоский машинно-читаемый формат
  --exclude PATTERN    Исключить по shell-шаблону; можно повторять
  --help               Показать справку
  --version            Показать версию

В Definition Zone ISM-файлы с -<order>- сортируются по числовому order;
остальные элементы сортируются по имени. Символические ссылки не обходятся.
EOF2
}

fail() { printf 'ОШИБКА: %s\n\n' "$1" >&2; usage >&2; exit 1; }

get_link_target() {
  if command -v readlink >/dev/null 2>&1; then readlink -- "$1" 2>/dev/null
  else ls -ld -- "$1" 2>/dev/null | sed 's/.* -> //'
  fi
}

sort_items() {
  _in_definition="$1"
  awk -v ism="$_in_definition" '
  {
    path=$0; name=path; sub(/^.*\//,"",name)
    if (ism == "true" && match(name,/^-[0-9]+-(manifest|meta|spec|exact)-/)) {
      ord=substr(name,2,index(substr(name,2),"-")-1)+0
      printf "0:%020d:%s\t%s\n", ord, name, path
    } else {
      printf "1:%s\t%s\n", name, path
    }
  }' | LC_ALL=C sort | cut -f2-
}

excluded() (
  _name="$1"; _rel="$2"
  set -f
  for _pat in $exclude_patterns; do
    case "$_name" in $_pat) set +f; return 0 ;; esac
    case "$_rel" in $_pat) set +f; return 0 ;; esac
  done
  set +f
  return 1
)

process_dir() (
  _path="$1"; _prefix="$2"; _rel="$3"; _in_definition="$4"

  if [ "$show_hidden" = true ]; then
    _items=$(find "$_path" -mindepth 1 -maxdepth 1 -print 2>/dev/null | sort_items "$_in_definition")
  else
    _items=$(find "$_path" -mindepth 1 -maxdepth 1 ! -name '.*' -print 2>/dev/null | sort_items "$_in_definition")
  fi

  _filtered=""
  while IFS= read -r _full; do
    [ -z "$_full" ] && continue
    _name=$(basename -- "$_full")
    _current_rel="${_rel:+$_rel/}$_name"
    excluded "$_name" "$_current_rel" && continue
    _filtered="${_filtered}${_filtered:+
}$_full"
  done << EOF2
$_items
EOF2

  [ -z "$_filtered" ] && return
  _total=$(printf '%s\n' "$_filtered" | wc -l | tr -d ' ')
  _count=0

  while IFS= read -r _full; do
    _count=$((_count + 1))
    _name=$(basename -- "$_full")
    _current_rel="${_rel:+$_rel/}$_name"
    _is_link=false; [ -L "$_full" ] && _is_link=true
    _is_dir=false; [ -d "$_full" ] && _is_dir=true

    _suffix=""
    if [ "$_is_link" = true ]; then
      _target=$(get_link_target "$_full")
      _suffix=" -> $_target"
    fi

    if [ "$plain_mode" = true ]; then
      _display="$_current_rel"
      [ "$_is_dir" = true ] && _display="${_display%/}/"
      printf '%s%s\n' "$_display" "$_suffix"
    else
      if [ "$_count" -eq "$_total" ]; then _conn='└── '; _next_prefix="${_prefix}    "
      else _conn='├── '; _next_prefix="${_prefix}│   "
      fi
      _display="$_name"; [ "$_is_dir" = true ] && _display="${_display%/}/"
      printf '%s%s%s%s\n' "$_prefix" "$_conn" "$_display" "$_suffix"
    fi

    if [ "$_is_dir" = true ] && [ "$_is_link" = false ]; then
      [ "$plain_mode" = true ] && _next_prefix=""
      _next_in_definition="$_in_definition"
      [ "$_name" = "ism" ] && _next_in_definition=true
      process_dir "$_full" "$_next_prefix" "$_current_rel" "$_next_in_definition"
    fi
  done << EOF2
$_filtered
EOF2
)

show_hidden=false
plain_mode=false
exclude_patterns=""
target="."
target_set=false

while [ $# -gt 0 ]; do
  case "$1" in
    --all) show_hidden=true; shift ;;
    --plain) plain_mode=true; shift ;;
    --exclude) [ $# -lt 2 ] && fail '--exclude требует PATTERN'; exclude_patterns="${exclude_patterns:+$exclude_patterns }$2"; shift 2 ;;
    --help) usage; exit 0 ;;
    --version) printf 'ism-tree %s\n' "$version"; exit 0 ;;
    -*) fail "Неизвестная опция '$1'" ;;
    *) [ "$target_set" = true ] && fail 'Можно указать только одну директорию'; target="$1"; target_set=true; shift ;;
  esac
done

[ ! -e "$target" ] && fail "Путь '$target' не существует"
[ -L "$target" ] && fail 'Корневая директория не может быть символической ссылкой'

if [ "$plain_mode" = true ]; then printf '.\n'; else printf '%s\n' "${target%/}"; fi

_in_definition=false
[ "$(basename -- "${target%/}")" = "ism" ] && _in_definition=true
[ -d "$target" ] && process_dir "${target%/}" "" "" "$_in_definition"
