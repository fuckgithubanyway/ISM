#!/usr/bin/env sh

version="1.0"

usage() {
  cat << EOF2
ISM Snapshot — единый текстовый снимок директории.
Версия: $version

Использование: $(basename "$0") [ОПЦИИ] [директория]

Опции:
  --all                Включать скрытые файлы и директории
  --exclude PATTERN    Исключить по shell-шаблону; можно повторять
  --output FILE        Записать снимок в файл
  --help               Показать справку
  --version            Показать версию

Символические ссылки отображаются, но не разыменовываются.
EOF2
}

fail() { printf 'ОШИБКА: %s\n\n' "$1" >&2; usage >&2; exit 1; }
print_header() { printf '%s\n' "---- ISM: $1 ----"; }

is_binary_file() {
  [ ! -f "$1" ] && return 1
  od -An -tx1 -N 1024 -- "$1" 2>/dev/null | grep -q ' 00'
}

get_file_size() {
  wc -c < "$1" 2>/dev/null | tr -d ' '
}

show_hidden=false
output_file=""
exclude_patterns=""
target_dir="."
target_set=false

while [ $# -gt 0 ]; do
  case "$1" in
    --all) show_hidden=true; shift ;;
    --exclude) [ $# -lt 2 ] && fail '--exclude требует PATTERN'; exclude_patterns="${exclude_patterns:+$exclude_patterns }$2"; shift 2 ;;
    --output) [ $# -lt 2 ] && fail '--output требует FILE'; output_file="$2"; shift 2 ;;
    --help) usage; exit 0 ;;
    --version) printf 'ism-snapshot %s\n' "$version"; exit 0 ;;
    -*) fail "Неизвестная опция '$1'" ;;
    *) [ "$target_set" = true ] && fail 'Можно указать только одну директорию'; target_dir="$1"; target_set=true; shift ;;
  esac
done

[ ! -d "$target_dir" ] && fail "Директория '$target_dir' не найдена"
[ -L "$target_dir" ] && fail 'Корневая директория не может быть символической ссылкой'

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
ISM_TREE="$SCRIPT_DIR/ism-tree"
[ ! -x "$ISM_TREE" ] && fail "ism-tree не найден в $SCRIPT_DIR"

T_TREE="${TMPDIR:-/tmp}/ism_snapshot_tree_$$"
cleanup() { rm -f "$T_TREE" 2>/dev/null; }
trap cleanup EXIT HUP INT TERM

(
  cd -- "$target_dir" || exit 1
  set -- --plain
  [ "$show_hidden" = true ] && set -- "$@" --all
  for pat in $exclude_patterns; do set -- "$@" --exclude "$pat"; done
  set -- "$@" .
  exec "$ISM_TREE" "$@"
) > "$T_TREE" || fail 'Ошибка генерации структуры'

generate_snapshot() {
  print_header 'SNAPSHOT BEGIN'
  printf 'Root: .\n'
  printf 'Tool: ism-snapshot %s\n' "$version"
  printf 'Hidden: %s\n' "$show_hidden"
  printf 'Exclude: %s\n\n' "${exclude_patterns:-(none)}"

  print_header 'PROJECT STRUCTURE'
  cat "$T_TREE"
  printf '\n'

  tail -n +2 "$T_TREE" | while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      */) continue ;;
      *' -> '*) continue ;;
    esac

    full="$target_dir/$line"
    [ ! -f "$full" ] && continue
    size=$(get_file_size "$full")

    if [ ! -s "$full" ]; then
      printf '%s\n\n' "---- ISM: EMPTY FILE $line (bytes: 0) ----"
    elif is_binary_file "$full"; then
      printf '%s\n\n' "---- ISM: BINARY FILE $line (bytes: $size) ----"
    else
      printf '%s\n' "---- ISM: FILE BEGIN $line (bytes: $size) ----"
      cat -- "$full"
      printf '\n%s\n\n' "---- ISM: FILE END $line ----"
    fi
  done

  print_header 'SNAPSHOT END'
}

if [ -n "$output_file" ]; then
  generate_snapshot > "$output_file" || fail "Не удалось записать $output_file"
  printf 'Снимок сохранён: %s\n' "$output_file" >&2
else
  generate_snapshot
fi
